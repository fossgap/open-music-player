  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Native GtkButton with the suggested-action style; sage fill, dark ink, and a heavier label. Shared focus outline is 2px sage with 2px offset."
    },
    {
      "name": "Ordinary action",
      "kind": "button",
      "refersTo": "button",
      "description": "Native GtkButton with raised, hover, and pressed surfaces; disabled opacity is 0.38. Symbolic secondary actions use the transparent flat variant."
    },
    {
      "name": "Play / pause",
      "kind": "button",
      "refersTo": "button-play",
      "description": "Circular native transport action, shared by the full and mini players; its symbolic icon follows playback."
    },
    {
      "name": "Search and URL field",
      "kind": "input",
      "refersTo": "field",
      "description": "Native GtkSearchEntry or GtkEntry with a thin outline, fully opaque muted placeholder, and the shared focus outline."
    },
    {
      "name": "Listening navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Native buttons in a vertically scrollable rail. The selected destination uses navigation-selected. The header supplies an explicit visibility toggle."
    },
    {
      "name": "Track row",
      "kind": "custom",
      "refersTo": "track-row",
      "description": "Native virtualized GtkListView row with artwork, ellipsized two-line metadata, album, duration, favorite, and options. Playing text, hover, and selection are separate states."
    },
    {
      "name": "Album artwork",
      "kind": "custom",
      "refersTo": "album-art",
      "description": "Native GtkGridView tile with artwork, title, and artist; two to five columns, single-click activation, no enclosing card shadow."
    },
    {
      "name": "Favorite toggle",
      "kind": "button",
      "refersTo": "toggle-active",
      "description": "Native GtkToggleButton. Inactive outline star and Add to favorites label become a filled star, checked state, and Remove from favorites label together."
    },
    {
      "name": "Persistent transport",
      "kind": "custom",
      "refersTo": "player-bar",
      "description": "Native horizontal player outside scrolling content, retaining current-track context, transport, seek, volume, and mini-player access."
    },
    {
      "name": "Now-playing panel",
      "kind": "custom",
      "refersTo": "detail-panel",
      "description": "Native detail pane with real cover pixels softly blended behind contained artwork, an authentic decoded-audio waveform, and independently scrolling lyrics."
    }
  ],
  "narrative": {
    "northStar": "A quiet listening room",
    "overview": "Deep green-black surfaces, warm ivory text, and soft sage actions create a calm place to listen. Artwork supplies the individual character of each recording; the surrounding interface stays restrained and legible in low ambient light.\n\nThis is a native Linux GTK application in Operate mode. Familiar symbolic icons, system sans typography, a stable navigation rail, and a persistent transport support repeated listening tasks. The library is compact enough to scan while section headings and artwork retain breathing room.",
    "keyCharacteristics": [
      "Dark tonal surfaces with one sage interaction accent.",
      "Native GTK controls and concise action labels.",
      "A stable library structure and persistent playback controls.",
      "Real artwork, a softly blended cover backdrop, and a waveform derived from decoded audio."
    ],
    "rules": [
      {
        "name": "The Sage State Rule",
        "body": "Use sage to identify an action, focus, or playback state; let album artwork carry decorative color.",
        "section": "colors"
      },
      {
        "name": "The Persistent Transport Rule",
        "body": "Keep current-track context and playback controls outside scrolling library content.",
        "section": "layout"
      },
      {
        "name": "The Real Media Rule",
        "body": "Artwork and waveform behavior must be driven by the current media; missing artwork gets a deliberate placeholder and silence does not produce invented activity.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** keep the rail, library, detail panel, and transport legible as connected tonal regions.",
      "**Do** use sage for primary actions, focus, checked controls, and current playback state.",
      "**Do** preserve visible keyboard focus and native accessible control semantics.",
      "**Do** update favorite icon, checked state, tooltip, and accessible label together.",
      "**Do** use real media artwork and decoded audio for the backdrop and waveform.",
      "**Do** keep navigation and library content scrollable while playback controls stay available.",
      "**Do** retain ellipsis, wrapping, and concise localized action labels where the existing components use them."
    ],
    "donts": [
      "**Don't** replace the native system sans or symbolic icon language with unrelated decorative styles.",
      "**Don't** add card shadows or extra container borders to the flat library rows and album tiles.",
      "**Don't** use a frequency spectrum, random bars, or looping decoration in place of the audio waveform.",
      "**Don't** hide a favorite's state behind color alone or reduce placeholder contrast through opacity.",
      "**Don't** claim automatic narrow-window navigation collapse; the rail has an explicit toggle and a detail-panel interaction rule."
    ]
  }
}
