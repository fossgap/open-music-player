<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="mini_window"><property name="title">Open Audio · Mini</property><property name="default-width">420</property><property name="resizable">false</property>
    <child><object class="GtkBox"><property name="spacing">14</property><property name="margin-start">16</property><property name="margin-end">12</property><property name="margin-top">14</property><property name="margin-bottom">14</property>
      <child><object class="GtkOverlay"><property name="child"><object class="GtkImage"><property name="icon-name">audio-x-generic-symbolic</property><property name="width-request">54</property><property name="height-request">54</property><style><class name="cover-placeholder"/></style></object></property><child type="overlay"><object class="GtkPicture" id="mini_art"><property name="content-fit">cover</property><property name="can-shrink">true</property><style><class name="cover"/></style></object></child></object></child>
      <child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property><property name="valign">center</property><property name="spacing">5</property>
        <child><object class="GtkLabel" id="mini_title"><property name="label">Nothing playing</property><property name="xalign">0</property><property name="ellipsize">end</property><property name="max-width-chars">22</property><style><class name="track-title"/></style></object></child>
        <child><object class="GtkLabel" id="mini_artist"><property name="xalign">0</property><property name="ellipsize">end</property><property name="max-width-chars">22</property><style><class name="muted"/><class name="small"/></style></object></child>
      </object></child>
      <child><object class="GtkButton" id="mini_play"><property name="icon-name">media-playback-start-symbolic</property><property name="action-name">app.play</property><property name="tooltip-text">Play / pause</property><property name="valign">center</property><style><class name="play-button"/></style></object></child>
      <child><object class="GtkButton"><property name="icon-name">media-skip-forward-symbolic</property><property name="action-name">app.next</property><property name="tooltip-text">Next</property><property name="valign">center</property><style><class name="flat"/></style></object></child>
      <child><object class="GtkButton" id="mini_expand"><property name="icon-name">view-fullscreen-symbolic</property><property name="tooltip-text">Full player</property><property name="valign">center</property><style><class name="flat"/></style></object></child>
    </object></child>
  </object>
</interface>
