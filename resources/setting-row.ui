<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="row"><property name="spacing">12</property><property name="margin-top">4</property><property name="margin-bottom">4</property>
    <child><object class="GtkLabel" id="name"><property name="hexpand">true</property><property name="xalign">0</property><property name="ellipsize">middle</property><property name="max-width-chars">45</property></object></child>
    <child><object class="GtkButton" id="remove"><property name="icon-name">list-remove-symbolic</property><property name="tooltip-text">Remove</property><style><class name="flat"/></style></object></child>
  </object>
</interface>
