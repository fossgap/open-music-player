<?xml version='1.0' encoding='utf-8'?>
<interface>
  <object class="GtkBox" id="podcast_card">
    <style><class name="podcast-card" /></style>
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin-start">8</property>
    <property name="margin-end">8</property>
    <property name="margin-top">8</property>
    <property name="margin-bottom">20</property>
    <child>
      <object class="GtkBox" id="podcast_content">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkAspectFrame">
            <property name="ratio">1</property>
            <property name="obey-child">false</property>
            <property name="xalign">0</property>
            <property name="child">
              <object class="GtkOverlay">
                <property name="child">
                  <object class="GtkImage" id="placeholder">
                    <property name="icon-name">audio-input-microphone-symbolic</property>
                    <property name="pixel-size">56</property>
                    <property name="width-request">160</property>
                    <property name="height-request">160</property>
                    <style>
                      <class name="album-placeholder" />
                    </style>
                  </object>
                </property>
                <child type="overlay">
                  <object class="GtkPicture" id="art">
                    <property name="content-fit">cover</property>
                    <property name="can-shrink">true</property>
                    <style>
                      <class name="cover" />
                    </style>
                  </object>
                </child>
              </object>
            </property>
            <property name="halign">start</property>
            <property name="valign">start</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="title">
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <property name="max-width-chars">20</property>
                <style>
                  <class name="track-title" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="author">
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <property name="max-width-chars">20</property>
                <style>
                  <class name="muted" />
                  <class name="small" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="podcast_actions">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkButton" id="subscribe">
            <property name="label">Subscribe</property>
            <property name="halign">start</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton" id="website">
            <property name="label">Podcast website</property>
            <property name="uri">https://podcasts.apple.com/</property>
            <property name="halign">start</property>
            <style>
              <class name="flat" />
              <class name="small" />
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
