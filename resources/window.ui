<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.8" />
  <object class="GtkAdjustment" id="seek_adjustment">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="volume_adjustment">
    <property name="upper">1</property>
    <property name="step-increment">0.05</property>
    <property name="value">0.75</property>
  </object>
  <object class="GtkApplicationWindow" id="window">
    <property name="title">Open Audio Player</property>
    <property name="default-width">1240</property>
    <property name="default-height">800</property>
    <property name="width-request">760</property>
    <property name="height-request">580</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="header">
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label">Open Audio</property>
            <style>
              <class name="header-title" />
            </style>
          </object>
        </property>
        <child type="start">
          <object class="GtkButton" id="sidebar_toggle">
            <property name="icon-name">sidebar-show-symbolic</property>
            <property name="tooltip-text">Toggle sidebar</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <child type="end">
          <object class="GtkMenuButton" id="main_menu">
            <property name="icon-name">open-menu-symbolic</property>
            <property name="tooltip-text">Main menu</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="vexpand">true</property>
            <child>
              <object class="GtkScrolledWindow" id="sidebar_scroller">
                <property name="hexpand">false</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="width-request">200</property>
                <style>
                  <class name="sidebar-scroll" />
                </style>
                <property name="child">
                  <object class="GtkBox" id="sidebar">
                    <property name="orientation">vertical</property>
                    <property name="width-request">200</property>
                    <property name="spacing">6</property>
                    <style>
                      <class name="sidebar" />
                    </style>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">10</property>
                        <property name="margin-bottom">28</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">audio-x-generic-symbolic</property>
                            <property name="pixel-size">26</property>
                            <style>
                              <class name="accent" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">open audio</property>
                            <style>
                              <class name="brand" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="nav_library">
                        <property name="action-name">app.page</property>
                        <property name="action-target">'library'</property>
                        <style>
                          <class name="nav" />
                          <class name="selected" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">folder-music-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Your music</property>
                                <property name="xalign">0</property>
                                <property name="valign">baseline</property>
                                <property name="hexpand">true</property>
                                <property name="ellipsize">end</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="library_status">
                                <property name="xalign">1</property>
                                <property name="valign">baseline</property>
                                <property name="ellipsize">end</property>
                                <property name="max-width-chars">6</property>
                                <style>
                                  <class name="muted" />
                                  <class name="small" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="nav_favorites">
                        <property name="action-name">app.page</property>
                        <property name="action-target">'favorites'</property>
                        <style>
                          <class name="nav" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">starred-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Favorites</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="nav_playlists">
                        <property name="action-name">app.page</property>
                        <property name="action-target">'playlists'</property>
                        <style>
                          <class name="nav" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">view-list-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Playlists</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator">
                        <property name="margin-top">18</property>
                        <property name="margin-bottom">18</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="nav_podcasts">
                        <property name="action-name">app.page</property>
                        <property name="action-target">'podcasts'</property>
                        <style>
                          <class name="nav" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">audio-input-microphone-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Podcasts</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="nav_radio">
                        <property name="action-name">app.page</property>
                        <property name="action-target">'radio'</property>
                        <style>
                          <class name="nav" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">network-wireless-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Live radio</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="nav_streams">
                        <property name="action-name">app.streaming</property>
                        <style>
                          <class name="nav" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">network-server-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Streaming</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child><object class="GtkButton" id="nav_downloads"><property name="action-name">app.page</property><property name="action-target">'downloads'</property><style><class name="nav"/></style><property name="child"><object class="GtkBox"><property name="spacing">12</property><child><object class="GtkImage"><property name="icon-name">folder-download-symbolic</property></object></child><child><object class="GtkLabel"><property name="label">Downloads</property></object></child></object></property></object></child>
                    <child>
                      <object class="GtkBox">
                        <property name="vexpand">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="nav_queue">
                        <property name="action-name">app.page</property>
                        <property name="action-target">'queue'</property>
                        <style>
                          <class name="nav" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">view-list-bullet-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Play queue</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton">
                        <property name="action-name">app.settings</property>
                        <style>
                          <class name="nav" />
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">preferences-system-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Settings</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="content">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <property name="spacing">20</property>
                <property name="margin-start">32</property>
                <property name="margin-end">32</property>
                <property name="margin-top">26</property>
                <property name="margin-bottom">20</property>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">16</property>
                    <child>
                      <object class="GtkButton" id="browse_back">
                        <property name="visible">false</property>
                        <property name="icon-name">go-previous-symbolic</property>
                        <property name="tooltip-text">Back</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">true</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkLabel" id="page_title">
                            <property name="label">Your music</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="page-title" />
                            </style>
                            <property name="ellipsize">end</property>
                            <property name="max-width-chars">32</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="page_subtitle">
                            <property name="label">A little closer to the music.</property>
                            <property name="xalign">0</property>
                            <property name="ellipsize">end</property>
                            <style>
                              <class name="muted" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="refresh">
                        <property name="icon-name">view-refresh-symbolic</property>
                        <property name="tooltip-text">Refresh</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="playlist_import">
                        <property name="visible">false</property>
                        <property name="icon-name">document-open-symbolic</property>
                        <property name="tooltip-text">Import playlist</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="playlist_delete">
                        <property name="visible">false</property>
                        <property name="icon-name">user-trash-symbolic</property>
                        <property name="tooltip-text">Delete playlist</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="page_action">
                        <property name="label">Add music</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="suggested-action" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="playlist_options">
                        <property name="visible">false</property>
                        <property name="icon-name">view-more-symbolic</property>
                        <property name="tooltip-text">Playlist options</property>
                        <property name="valign">center</property>
                        <style><class name="flat" /></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="notice">
                    <property name="visible">false</property>
                    <property name="spacing">12</property>
                    <style>
                      <class name="notice" />
                    </style>
                    <child>
                      <object class="GtkSpinner" id="busy_spinner" />
                    </child>
                    <child>
                      <object class="GtkLabel" id="notice_text">
                        <property name="wrap">true</property>
                        <property name="xalign">0</property>
                        <property name="hexpand">true</property>
                        <property name="selectable">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="dismiss_notice">
                        <property name="icon-name">window-close-symbolic</property>
                        <property name="tooltip-text">Dismiss</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="entry_bar">
                    <property name="visible">false</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkEntry" id="url_entry">
                        <property name="hexpand">true</property>
                        <property name="placeholder-text">Paste an audio URL</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="url_submit">
                        <property name="label">Add</property>
                        <style>
                          <class name="suggested-action" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="url_cancel">
                        <property name="icon-name">window-close-symbolic</property>
                        <property name="tooltip-text">Cancel</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child><object class="GtkBox" id="streaming_services">
                  <property name="visible">false</property><property name="spacing">8</property>
                  <child><object class="GtkToggleButton" id="service_youtube"><property name="label">YouTube Music</property><property name="active">true</property></object></child>
                  <child><object class="GtkToggleButton" id="service_spotify"><property name="label">Spotify</property><property name="group">service_youtube</property></object></child>
                  <child><object class="GtkToggleButton" id="service_streams"><property name="label">Internet streams</property><property name="group">service_youtube</property></object></child>
                </object></child>
                <child>
                  <object class="GtkBox" id="youtube_tabs">
                    <property name="visible">false</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child><object class="GtkBox">
                      <property name="spacing">8</property>
                      <child><object class="GtkToggleButton" id="youtube_songs"><property name="label">Search music</property><property name="active">true</property></object></child>
                      <child><object class="GtkToggleButton" id="youtube_playlists"><property name="label">Your playlists</property><property name="group">youtube_songs</property></object></child>
                      <child><object class="GtkBox"><property name="hexpand">true</property></object></child>
                      <child><object class="GtkButton" id="youtube_sync"><property name="label">Sync playlists</property><property name="tooltip-text">Download online changes and upload local edits to linked playlists</property></object></child>
                    </object></child>
                    <child><object class="GtkBox">
                      <property name="spacing">12</property>
                      <child><object class="GtkLabel" id="youtube_status"><property name="hexpand">true</property><property name="xalign">0</property><property name="ellipsize">end</property><property name="width-chars">12</property><style><class name="muted" /></style></object></child>
                    </object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="spotify_tabs">
                    <property name="visible">false</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child><object class="GtkBox">
                      <property name="spacing">8</property>
                      <child><object class="GtkToggleButton" id="spotify_songs"><property name="label">Search music</property><property name="active">true</property></object></child>
                      <child><object class="GtkToggleButton" id="spotify_playlists"><property name="label">Your playlists</property><property name="group">spotify_songs</property></object></child>
                      <child><object class="GtkBox"><property name="hexpand">true</property></object></child>
                      <child><object class="GtkButton" id="spotify_sync"><property name="label">Sync playlists</property><property name="tooltip-text">Download online changes and upload local edits to linked playlists</property></object></child>
                    </object></child>
                    <child><object class="GtkBox">
                      <property name="spacing">12</property>
                      <child><object class="GtkLabel" id="spotify_status"><property name="hexpand">true</property><property name="xalign">0</property><property name="ellipsize">end</property><property name="width-chars">12</property><style><class name="muted" /></style></object></child>
                    </object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="podcast_tabs">
                    <property name="visible">false</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkToggleButton" id="podcast_library">
                        <property name="label">Your episodes</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkToggleButton" id="podcast_discover">
                        <property name="label">Discover podcasts</property>
                        <property name="group">podcast_library</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="toolbar">
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkSearchEntry" id="search">
                        <property name="placeholder-text">Search your music</property>
                        <property name="hexpand">true</property>
                        <property name="width-request">180</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="podcast_provider">
                        <property name="visible">false</property>
                        <property name="tooltip-text">Podcast directory</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="podcast_search">
                        <property name="visible">false</property>
                        <property name="icon-name">system-search-symbolic</property>
                        <property name="tooltip-text">Search podcasts</property>
                      </object>
                    </child>
                    <child><object class="GtkButton" id="youtube_search"><property name="visible">false</property><property name="icon-name">system-search-symbolic</property><property name="tooltip-text">Search YouTube Music</property></object></child>
                    <child><object class="GtkButton" id="spotify_search"><property name="visible">false</property><property name="icon-name">system-search-symbolic</property><property name="tooltip-text">Search Spotify</property></object></child>
                    <child>
                      <object class="GtkBox" id="view_switch">
                        <style>
                          <class name="linked" />
                        </style>
                        <child>
                          <object class="GtkToggleButton" id="tracks_view">
                            <property name="icon-name">view-list-symbolic</property>
                            <property name="active">true</property>
                            <property name="tooltip-text">Tracks</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="albums_view">
                            <property name="icon-name">view-grid-symbolic</property>
                            <property name="group">tracks_view</property>
                            <property name="tooltip-text">Albums</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="play_all">
                        <property name="label">Play all</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="content_stack">
                    <property name="vexpand">true</property>
                    <property name="transition-type">crossfade</property>
                    <property name="transition-duration">150</property>
                    <child><object class="GtkStackPage"><property name="name">downloads</property><property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">18</property>
                      <child><object class="GtkBox"><property name="spacing">12</property><child><object class="GtkLabel"><property name="label">Cancel a download to resume it later. Stop and save keeps a recording.</property><property name="wrap">true</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="muted"/><class name="small"/></style></object></child><child><object class="GtkButton"><property name="label">Download folder</property><property name="action-name">app.download-settings</property><property name="valign">center</property></object></child></object></child>
                      <child><object class="GtkScrolledWindow"><property name="vexpand">true</property><property name="hscrollbar-policy">never</property><property name="child"><object class="GtkBox"><property name="orientation">vertical</property>
                        <child><object class="GtkBox" id="downloads_empty"><property name="orientation">vertical</property><property name="spacing">16</property><property name="margin-top">60</property><property name="margin-bottom">60</property><child><object class="GtkImage"><property name="icon-name">folder-download-symbolic</property><property name="pixel-size">48</property><style><class name="muted"/></style></object></child><child><object class="GtkLabel"><property name="label">Keep something for later.</property><property name="wrap">true</property><property name="justify">center</property><style><class name="empty-title"/></style></object></child><child><object class="GtkLabel"><property name="label">Use the player’s save button or an online track’s options to download or record audio.</property><property name="wrap">true</property><property name="justify">center</property><property name="max-width-chars">48</property><style><class name="muted"/></style></object></child></object></child>
                        <child><object class="GtkListBox" id="downloads_list"><property name="selection-mode">none</property><style><class name="download-list"/></style></object></child>
                      </object></property></object></child>
                    </object></property></object></child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">empty</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vscrollbar-policy">automatic</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <property name="halign">center</property>
                                <property name="spacing">16</property>
                                <child>
                                  <object class="GtkDrawingArea" id="empty_art">
                                    <property name="content-width">160</property>
                                    <property name="content-height">160</property>
                                    <property name="halign">center</property>
                                    <property name="margin-bottom">12</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="empty_title">
                                    <property name="label">Your next favorite is already yours.</property>
                                    <property name="wrap">true</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="empty-title" />
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="empty_description">
