                                              <object class="GtkScrolledWindow" id="discography_scroller">
                                                <property name="hscrollbar-policy">never</property>
                                                <property name="min-content-height">64</property>
                                                <property name="max-content-height">240</property>
                                                <property name="propagate-natural-height">true</property>
                                                <property name="child">
                                                  <object class="GtkListBox" id="discography_list">
                                                    <property name="selection-mode">single</property>
                                                    <property name="activate-on-single-click">false</property>
                                                    <style><class name="discography-list"/></style>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="discography_status">
                                                <property name="wrap">true</property>
                                                <property name="wrap-mode">word-char</property>
                                                <property name="max-width-chars">24</property>
                                                <property name="xalign">0</property>
                                                <style>
                                                  <class name="small" />
                                                  <class name="muted" />
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="discography_more">
                                                <property name="label">Load more releases</property>
                                                <property name="halign">start</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="player_bar">
            <property name="spacing">20</property>
            <style>
              <class name="player-bar" />
            </style>
            <child>
              <object class="GtkButton" id="art_button">
                <property name="tooltip-text">Playback details</property>
                <style>
                  <class name="flat" />
                  <class name="art-button" />
                </style>
                <property name="child">
                  <object class="GtkOverlay">
                    <property name="child">
                      <object class="GtkImage" id="player_placeholder">
                        <property name="icon-name">audio-x-generic-symbolic</property>
                        <property name="pixel-size">28</property>
                        <property name="width-request">60</property>
                        <property name="height-request">60</property>
                        <style>
                          <class name="cover-placeholder" />
                        </style>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="GtkPicture" id="player_art">
                        <property name="content-fit">cover</property>
                        <property name="can-shrink">true</property>
                        <style>
                          <class name="cover" />
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="player_metadata">
                <property name="orientation">vertical</property>
                <property name="valign">center</property>
                <property name="spacing">5</property>
                <property name="width-request">150</property>
                <child>
                  <object class="GtkLabel" id="player_title">
                    <property name="label">Nothing playing</property>
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                    <property name="max-width-chars">22</property>
                    <style>
                      <class name="track-title" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="player_artist">
                    <property name="label">Pick something you love.</property>
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                    <property name="max-width-chars">22</property>
                    <style>
                      <class name="small" />
                      <class name="muted" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="player_favorite">
                <property name="icon-name">non-starred-symbolic</property>
                <property name="tooltip-text">Favorite</property>
                <property name="valign">center</property>
                <property name="sensitive">false</property>
                <style>
                  <class name="flat" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkBox" id="playback_actions">
                    <property name="halign">center</property>
                    <property name="spacing">8</property>
                    <child><object class="GtkMenuButton" id="playback_speed"><property name="label">1×</property><property name="tooltip-text">Playback speed</property><property name="valign">center</property><style><class name="speed-control"/><class name="flat"/></style></object></child>
                    <child>
                      <object class="GtkToggleButton" id="shuffle">
                        <property name="icon-name">media-playlist-shuffle-symbolic</property>
                        <property name="tooltip-text">Shuffle</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="previous">
                        <property name="icon-name">media-skip-backward-symbolic</property>
                        <property name="tooltip-text">Previous</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="play">
                        <property name="icon-name">media-playback-start-symbolic</property>
                        <property name="tooltip-text">Play / pause</property>
                        <style>
                          <class name="play-button" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="next">
                        <property name="icon-name">media-skip-forward-symbolic</property>
                        <property name="tooltip-text">Next</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="repeat">
                        <property name="icon-name">media-playlist-repeat-symbolic</property>
                        <property name="tooltip-text">Repeat off</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child><object class="GtkButton" id="playback_download"><property name="action-name">app.save-current</property><property name="icon-name">folder-download-symbolic</property><property name="tooltip-text">Download audio</property><property name="valign">center</property><property name="sensitive">false</property><style><class name="flat"/><class name="player-side"/></style></object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkButton" id="time_toggle">
                        <property name="action-name">app.toggle-time</property>
                        <property name="tooltip-text">Show remaining time</property>
                        <style><class name="flat"/><class name="time-toggle"/></style>
                        <property name="child"><object class="GtkLabel" id="elapsed"><property name="label">0:00</property><property name="width-chars">6</property><style><class name="time"/></style></object></property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale" id="seek">
                        <property name="adjustment">seek_adjustment</property>
                        <property name="hexpand">true</property>
                        <property name="draw-value">false</property>
                        <property name="sensitive">false</property>
                        <property name="tooltip-text">Seek — scroll to move by 5 seconds</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="duration">
                        <property name="label">0:00</property>
                        <property name="width-chars">5</property>
                        <style>
                          <class name="time" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="player_output">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <property name="valign">fill</property>
                <child>
                  <object class="GtkBox" id="player_output_controls">
                    <property name="spacing">20</property>
                    <child>
                      <object class="GtkBox" id="volume_box">
                        <property name="spacing">4</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkButton" id="mute">
                            <property name="icon-name">audio-volume-high-symbolic</property>
                            <property name="tooltip-text">Mute</property>
                            <style>
                              <class name="flat" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScale" id="volume">
                            <property name="adjustment">volume_adjustment</property>
                            <property name="width-request">80</property>
                            <property name="draw-value">false</property>
                            <property name="tooltip-text">Volume — scroll to adjust by 5%</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="mini">
                        <property name="icon-name">view-restore-symbolic</property>
                        <property name="tooltip-text">Mini player</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="player_audio">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="visible">false</property>
                    <child>
                      <object class="GtkLabel" id="player_encoding">
                        <property name="ellipsize">end</property>
                        <property name="width-chars">1</property>
                        <property name="max-width-chars">22</property>
                        <property name="single-line-mode">true</property>
                        <style><class name="audio-summary"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="player_resolution">
                        <property name="ellipsize">end</property>
                        <property name="width-chars">1</property>
                        <property name="max-width-chars">22</property>
                        <property name="single-line-mode">true</property>
                        <style><class name="audio-summary"/></style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkSizeGroup" id="playback_sides"><property name="mode">horizontal</property><widgets><widget name="playback_speed"/><widget name="playback_download"/></widgets></object>
  <object class="GtkSizeGroup" id="playback_control_rows"><property name="mode">vertical</property><widgets><widget name="playback_actions"/><widget name="player_output_controls"/></widgets></object>
</interface>
