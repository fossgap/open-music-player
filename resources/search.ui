<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="global_search_root">
    <property name="orientation">vertical</property><property name="spacing">16</property><property name="vexpand">true</property><property name="visible">false</property>
    <child><object class="GtkBox"><property name="spacing">12</property>
      <child><object class="GtkButton" id="global_back"><property name="visible">false</property><property name="icon-name">go-previous-symbolic</property><property name="tooltip-text">Back to search results</property><property name="valign">center</property><style><class name="flat"/></style></object></child>
      <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">6</property><property name="hexpand">true</property>
        <child><object class="GtkLabel" id="global_title"><property name="label">Search</property><property name="xalign">0</property><property name="ellipsize">end</property><style><class name="page-title"/></style></object></child>
        <child><object class="GtkLabel" id="global_subtitle"><property name="label">Music, podcasts, radio and streams</property><property name="xalign">0</property><property name="ellipsize">end</property><style><class name="muted"/></style></object></child>
      </object></child>
      <child><object class="GtkButton" id="global_subscribe"><property name="visible">false</property><property name="label">Subscribe</property><property name="valign">center</property></object></child>
    </object></child>
    <child><object class="GtkBox"><property name="spacing">10</property>
      <child><object class="GtkSearchEntry" id="global_query"><property name="hexpand">true</property><property name="placeholder-text">Search all audio</property><property name="search-delay">180</property></object></child>
      <child><object class="GtkButton" id="global_submit"><property name="icon-name">system-search-symbolic</property><property name="tooltip-text">Search online</property><style><class name="suggested-action"/></style></object></child>
      <child><object class="GtkButton" id="global_cancel"><property name="icon-name">process-stop-symbolic</property><property name="tooltip-text">Cancel search</property><property name="visible">false</property><style><class name="flat"/></style></object></child>
    </object></child>
    <child><object class="GtkBox"><property name="spacing">12</property>
      <child><object class="GtkDropDown" id="global_filter"><property name="tooltip-text">Audio type</property></object></child>
      <child><object class="GtkSpinner" id="global_busy"><property name="visible">false</property></object></child>
      <child><object class="GtkLabel" id="global_count"><property name="hexpand">true</property><property name="xalign">1</property><property name="ellipsize">end</property><style><class name="muted"/><class name="small"/></style></object></child>
    </object></child>
    <child><object class="GtkBox" id="global_notice"><property name="visible">false</property><property name="spacing">8</property><style><class name="notice"/></style>
      <child><object class="GtkLabel" id="global_message"><property name="hexpand">true</property><property name="xalign">0</property><property name="wrap">true</property><property name="lines">3</property><property name="ellipsize">end</property></object></child>
      <child><object class="GtkButton" id="global_dismiss"><property name="icon-name">window-close-symbolic</property><property name="tooltip-text">Dismiss</property><property name="valign">center</property><style><class name="flat"/></style></object></child>
    </object></child>
    <child><object class="GtkStack" id="global_body"><property name="vexpand">true</property><property name="hhomogeneous">false</property><property name="vhomogeneous">false</property>
      <child><object class="GtkStackPage"><property name="name">results</property><property name="child"><object class="GtkScrolledWindow" id="global_scroller"><property name="hscrollbar-policy">never</property><property name="child"><object class="GtkListView" id="global_results"><property name="single-click-activate">false</property></object></property></object></property></object></child>
      <child><object class="GtkStackPage"><property name="name">empty</property><property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="valign">center</property><property name="spacing">12</property>
        <child><object class="GtkLabel" id="global_empty_title"><property name="label">Find something to listen to</property><property name="wrap">true</property><property name="justify">center</property><style><class name="section-title"/></style></object></child>
        <child><object class="GtkLabel" id="global_empty_detail"><property name="label">Search by title, artist, album, playlist or topic.</property><property name="wrap">true</property><property name="justify">center</property><property name="max-width-chars">48</property><style><class name="muted"/></style></object></child>
      </object></property></object></child>
    </object></child>
    <child><object class="GtkLabel" id="global_hint"><property name="label">Type to search your collection. Press Enter to search online.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="muted"/><class name="small"/></style></object></child>
  </object>
</interface>
