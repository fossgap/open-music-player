<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="row"><property name="spacing">14</property><style><class name="track-row"/></style>
    <child><object class="GtkImage" id="drag_handle"><property name="icon-name">list-drag-handle-symbolic</property><property name="visible">false</property><property name="pixel-size">16</property><property name="tooltip-text">Drag to reorder</property><style><class name="muted"/></style></object></child>
    <child><object class="GtkOverlay"><property name="child"><object class="GtkImage" id="placeholder"><property name="icon-name">audio-x-generic-symbolic</property><property name="pixel-size">20</property><property name="width-request">44</property><property name="height-request">44</property><style><class name="cover-placeholder"/></style></object></property><child type="overlay"><object class="GtkPicture" id="art"><property name="content-fit">cover</property><property name="can-shrink">true</property><style><class name="cover-small"/></style></object></child></object></child>
    <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">4</property><property name="valign">center</property><property name="hexpand">true</property>
      <child><object class="GtkLabel" id="title"><property name="xalign">0</property><property name="ellipsize">end</property><property name="width-chars">12</property><style><class name="track-title"/></style></object></child>
      <child><object class="GtkLabel" id="artist"><property name="xalign">0</property><property name="ellipsize">end</property><style><class name="muted"/><class name="small"/></style></object></child>
    </object></child>
    <child><object class="GtkLabel" id="album"><property name="xalign">0</property><property name="ellipsize">end</property><property name="width-chars">16</property><property name="max-width-chars">16</property><style><class name="muted"/><class name="small"/></style></object></child>
    <child><object class="GtkLabel" id="time"><property name="width-request">55</property><style><class name="time"/></style></object></child>
    <child><object class="GtkToggleButton" id="favorite"><property name="icon-name">non-starred-symbolic</property><property name="tooltip-text">Favorite</property><property name="valign">center</property><style><class name="flat"/></style></object></child>
    <child><object class="GtkMenuButton" id="menu"><property name="icon-name">view-more-symbolic</property><property name="tooltip-text">Track options</property><property name="valign">center</property><style><class name="flat"/></style></object></child>
  </object>
</interface>
