<?xml version='1.0' encoding='utf-8'?>
<interface>
  <object class="GtkWindow" id="tag_window">
    <property name="title">Edit tags</property>
    <property name="default-width">620</property>
    <property name="default-height">720</property>
    <property name="modal">true</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">16</property>
        <property name="margin-start">24</property>
        <property name="margin-end">24</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Edit tags</property>
                <property name="xalign">0</property>
                <style>
                  <class name="empty-title" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="tag_summary">
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <style>
                  <class name="muted" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="tag_hint">
                <property name="label">Only checked fields will change. Clear a checked field to remove its value.</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <style>
                  <class name="small" />
                  <class name="muted" />
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="tag_flow">
            <property name="vexpand">true</property>
            <property name="hhomogeneous">false</property>
            <property name="vhomogeneous">false</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">edit</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkStackSwitcher" id="tag_tabs">
                        <property name="stack">tag_pages</property>
                        <property name="hexpand">true</property>
                        <style>
                          <class name="detail-tabs" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStack" id="tag_pages">
                        <property name="vexpand">true</property>
                        <property name="hhomogeneous">true</property>
                        <property name="vhomogeneous">false</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">tags</property>
                            <property name="title">Tags</property>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkBox" id="tag_fields">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">14</property>
                                    <property name="margin-top">16</property>
                                    <property name="margin-bottom">8</property>
                                    <property name="margin-start">4</property>
                                    <property name="margin-end">4</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">artwork</property>
                            <property name="title">Artwork</property>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">16</property>
                                    <property name="margin-top">20</property>
                                    <property name="margin-bottom">12</property>
                                    <child>
                                      <object class="GtkCheckButton" id="apply_cover">
                                        <property name="label">Change artwork</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkPicture" id="tag_cover">
                                        <property name="height-request">180</property>
                                        <property name="can-shrink">true</property>
                                        <property name="content-fit">contain</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="tag_cover_name">
                                        <property name="wrap">true</property>
                                        <property name="selectable">true</property>
                                        <style>
                                          <class name="muted" />
                                          <class name="small" />
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">12</property>
                                        <property name="halign">center</property>
                                        <child>
                                          <object class="GtkButton" id="choose_tag_cover">
                                            <property name="label">Choose cover</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="remove_tag_cover">
                                            <property name="label">Remove cover</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label">Choose a PNG or JPEG cover, up to 20 MB. Shared folder artwork is left untouched.</property>
                                        <property name="wrap">true</property>
                                        <property name="xalign">0</property>
                                        <style>
                                          <class name="muted" />
                                          <class name="small" />
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">lyrics</property>
                            <property name="title">Lyrics</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                                <property name="margin-top">16</property>
                                <property name="margin-bottom">8</property>
                                <child>
                                  <object class="GtkCheckButton" id="apply_lyrics">
                                    <property name="label">Change lyrics</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Paste plain lyrics or LRC text with timestamps. Existing sidecar files are left untouched.</property>
                                    <property name="wrap">true</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="muted" />
                                      <class name="small" />
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScrolledWindow">
                                    <property name="vexpand">true</property>
                                    <property name="hscrollbar-policy">never</property>
                                    <property name="child">
                                      <object class="GtkTextView" id="tag_lyrics">
                                        <property name="wrap-mode">word-char</property>
                                        <property name="top-margin">12</property>
                                        <property name="bottom-margin">12</property>
                                        <property name="left-margin">12</property>
                                        <property name="right-margin">12</property>
                                        <style>
                                          <class name="tag-lyrics" />
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">review</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="GtkBox" id="tag_review">
                        <property name="orientation">vertical</property>
                        <property name="spacing">16</property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="tag_status">
            <property name="visible">false</property>
            <property name="wrap">true</property>
            <property name="lines">6</property>
            <property name="ellipsize">end</property>
            <property name="xalign">0</property>
            <property name="selectable">true</property>
            <style>
              <class name="notice" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="tag_progress">
            <property name="visible">false</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="tag_destination_row">
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Save to</property>
                <property name="xalign">0</property>
                <property name="hexpand">true</property>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="tag_destination">
                <property name="tooltip-text">Save to</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="tag_destination_hint">
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <style>
              <class name="small" />
              <class name="muted" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="tag_reset">
                <property name="icon-name">view-refresh-symbolic</property>
                <property name="visible">false</property>
                <property name="tooltip-text">Remove library-only edits and read tags from the files</property>
                <style>
                  <class name="flat" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">true</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="tag_cancel">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="tag_back">
                <property name="label">Back</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="tag_commit">
                <property name="label">Review changes</property>
                <property name="sensitive">false</property>
                <style>
                  <class name="suggested-action" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
