<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkAdjustment" id="refresh_adjustment"><property name="lower">0</property><property name="upper">1440</property><property name="step-increment">1</property><property name="page-increment">15</property></object>
  <object class="GtkAdjustment" id="crossfade_adjustment"><property name="lower">0</property><property name="upper">12</property><property name="step-increment">1</property><property name="page-increment">3</property></object>
  <object class="GtkWindow" id="settings_window"><property name="title">Settings</property><property name="default-width">560</property><property name="default-height">580</property><property name="modal">true</property>
    <child><object class="GtkScrolledWindow"><property name="hscrollbar-policy">never</property><property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">22</property><style><class name="settings-body"/></style>
      <child><object class="GtkLabel"><property name="label">Make yourself at home.</property><property name="xalign">0</property><style><class name="empty-title"/></style></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Language</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkDropDown" id="language"><property name="tooltip-text">Language</property></object></child></object></child>
      <child><object class="GtkLabel" id="restart_note"><property name="label">Restart to apply language changes.</property><property name="visible">false</property><property name="xalign">0</property><style><class name="muted"/><class name="small"/></style></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Keep playing when the window closes</property><property name="wrap">true</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkSwitch" id="background"><property name="valign">center</property><property name="tooltip-text">Background playback</property></object></child></object></child>
      <child><object class="GtkLabel" id="tray_note"><property name="label">A system tray is required to close into the background.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="small"/><class name="muted"/></style></object></child>
      <child><object class="GtkSeparator"/></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Automatic refresh (minutes)</property><property name="wrap">true</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkSpinButton" id="refresh_minutes"><property name="adjustment">refresh_adjustment</property><property name="numeric">true</property><property name="tooltip-text">Automatic refresh interval in minutes; 0 means manual only</property></object></child></object></child>
      <child><object class="GtkLabel"><property name="label">0 means manual only. Refreshes music folders, podcast subscriptions, connected streaming playlists and open discovery views. Linked playlists use two-way synchronization.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="small"/><class name="muted"/></style></object></child>
      <child><object class="GtkSeparator"/></child>
      <child><object class="GtkLabel"><property name="label">Playback</property><property name="xalign">0</property><style><class name="section-title"/></style></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Gapless playback</property><property name="wrap">true</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkSwitch" id="gapless"><property name="valign">center</property><property name="tooltip-text">Gapless playback</property></object></child></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Crossfade (seconds)</property><property name="wrap">true</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkSpinButton" id="crossfade_seconds"><property name="adjustment">crossfade_adjustment</property><property name="numeric">true</property><property name="tooltip-text">Crossfade duration in seconds; 0 means off</property></object></child></object></child>
      <child><object class="GtkLabel"><property name="label">Gapless works with music files, YouTube Music and Spotify. Crossfade works with music files and YouTube Music; 0 turns it off. Podcasts and radio never crossfade.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="small"/><class name="muted"/></style></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">ReplayGain</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkDropDown" id="replay_gain"><property name="tooltip-text">ReplayGain</property></object></child></object></child>
      <child><object class="GtkLabel"><property name="label">Uses existing loudness tags; untagged audio stays unchanged. Album gain preserves relative track volumes. Spotify uses its own loudness data; changes apply on the next track.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="small"/><class name="muted"/></style></object></child>
      <child><object class="GtkSeparator"/></child>
      <child><object class="GtkLabel"><property name="label">Online artwork and lyrics</property><property name="xalign">0</property><style><class name="section-title"/></style></object></child>
      <child><object class="GtkLabel"><property name="label">MusicBrainz / Cover Art Archive and LRCLIB find missing content. No accounts or API keys are needed. Artist, album and track details are sent to these services; existing content is kept and results are cached.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="small"/><class name="muted"/></style></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Find missing covers automatically</property><property name="wrap">true</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkSwitch" id="fetch_covers"><property name="valign">center</property><property name="tooltip-text">Find missing covers automatically</property></object></child></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Find missing lyrics automatically</property><property name="wrap">true</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkSwitch" id="fetch_lyrics"><property name="valign">center</property><property name="tooltip-text">Find missing lyrics automatically</property></object></child></object></child>
      <child><object class="GtkSeparator"/></child>
      <child><object class="GtkLabel"><property name="label">Music folders</property><property name="xalign">0</property><style><class name="section-title"/></style></object></child>
      <child><object class="GtkBox"><property name="spacing">20</property><child><object class="GtkLabel"><property name="label">Watch music folders for changes</property><property name="wrap">true</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkSwitch" id="watch_music"><property name="valign">center</property><property name="tooltip-text">Watch music folders for changes</property></object></child></object></child>
      <child><object class="GtkLabel"><property name="label">Updates added, changed and removed music files automatically, including subfolders. Unavailable folders keep their library entries.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="small"/><class name="muted"/></style></object></child>
      <child><object class="GtkListBox" id="folders"><property name="selection-mode">none</property></object></child>
      <child><object class="GtkButton" id="add_folder"><property name="label">Add music</property><property name="halign">start</property></object></child>
      <child><object class="GtkLabel"><property name="label">Subscriptions</property><property name="xalign">0</property><style><class name="section-title"/></style></object></child>
      <child><object class="GtkListBox" id="subscriptions"><property name="selection-mode">none</property></object></child>
      <child><object class="GtkSeparator"/></child>
      <child><object class="GtkLabel"><property name="label">Open Audio Player · 0.1.0</property><property name="xalign">0</property><style><class name="muted"/><class name="small"/></style></object></child>
      <child><object class="GtkButton" id="close"><property name="label">Done</property><property name="halign">end</property><style><class name="suggested-action"/></style></object></child>
    </object></property></object></child>
  </object>
</interface>
