<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <object class="GtkBox" id="album_card">
    <style><class name="album-card"/></style>
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin-start">8</property>
    <property name="margin-end">8</property>
    <property name="margin-bottom">20</property>
    <property name="margin-top">8</property>
    <child>
      <object class="GtkAspectFrame" id="art_frame">
        <property name="ratio">1</property>
        <property name="obey-child">false</property>
        <property name="child">
          <object class="GtkOverlay">
            <property name="child">
              <object class="GtkImage" id="placeholder">
                <property name="icon-name">media-optical-symbolic</property>
                <property name="pixel-size">64</property>
                <property name="height-request">160</property>
                <property name="width-request">160</property>
                <style>
                  <class name="album-placeholder" />
                </style>
              </object>
            </property>
            <child type="overlay">
              <object class="GtkPicture" id="art">
                <property name="content-fit">cover</property>
                <property name="can-shrink">true</property>
                <style>
                  <class name="cover" />
                </style>
              </object>
            </child>
            <child type="overlay"><object class="GtkButton" id="card_play">
              <property name="icon-name">media-playback-start-symbolic</property>
              <property name="tooltip-text">Play all</property>
              <property name="halign">end</property><property name="valign">end</property>
              <property name="margin-end">10</property><property name="margin-bottom">10</property>
              <style><class name="play-button"/><class name="card-play"/></style>
            </object></child>
          </object>
        </property>
        <property name="xalign">0</property>
      </object>
    </child>
    <child><object class="GtkBox" id="card_metadata">
      <property name="orientation">vertical</property>
      <property name="spacing">8</property>
    <child>
      <object class="GtkBox">
        <child>
          <object class="GtkLabel" id="title">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <property name="max-width-chars">16</property>
            <style>
              <class name="track-title" />
            </style>
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkMenuButton" id="menu">
            <property name="visible">false</property>
            <property name="icon-name">view-more-symbolic</property>
            <property name="tooltip-text">Playlist options</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="artist">
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
        <property name="max-width-chars">16</property>
        <style>
          <class name="muted" />
          <class name="small" />
        </style>
      </object>
    </child>
    </object></child>
  </object>
</interface>