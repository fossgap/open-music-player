<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="row"><property name="spacing">12</property><property name="margin-top">8</property><property name="margin-bottom">8</property><property name="margin-start">4</property><property name="margin-end">4</property>
    <child><object class="GtkOverlay" id="artwork"><property name="width-request">44</property><property name="height-request">44</property><property name="valign">center</property>
      <property name="child"><object class="GtkImage" id="icon"><property name="icon-name">audio-x-generic-symbolic</property><property name="pixel-size">24</property><style><class name="muted"/></style></object></property>
      <child type="overlay"><object class="GtkPicture" id="art"><property name="can-shrink">true</property><property name="content-fit">cover</property><style><class name="cover-small"/></style></object></child>
    </object></child>
    <child><object class="GtkBox" id="labels"><property name="orientation">vertical</property><property name="spacing">4</property><property name="valign">center</property><property name="hexpand">true</property>
      <child><object class="GtkLabel" id="title"><property name="xalign">0</property><property name="ellipsize">end</property></object></child>
      <child><object class="GtkLabel" id="detail"><property name="xalign">0</property><property name="ellipsize">end</property><style><class name="muted"/><class name="small"/></style></object></child>
    </object></child>
    <child><object class="GtkButton" id="primary"><property name="valign">center</property><property name="icon-name">media-playback-start-symbolic</property><style><class name="flat"/></style></object></child>
    <child><object class="GtkButton" id="secondary"><property name="valign">center</property><property name="icon-name">list-add-symbolic</property><style><class name="flat"/></style></object></child>
  </object>
</interface>
